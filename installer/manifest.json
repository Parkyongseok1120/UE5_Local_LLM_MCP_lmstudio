{
  "name": "Evidence-First Integrated Coding Stack",
  "productVersion": "1.3.0 RC3",
  "version": "2.1.3",
  "requires": {
    "python": "3.10+",
    "node": "20+",
    "lmStudio": "0.4+",
    "linuxBaseline": "Ubuntu 22.04/24.04 (glibc)"
  },
  "profiles": {
    "safe": ["codex", "lmstudio", "context_compactor"],
    "standard": ["codex", "lmstudio", "unreal", "context_compactor"],
    "full": ["codex", "lmstudio", "unreal", "context_compactor"],
    "custom": []
  },
  "components": [
    "codex",
    "lmstudio",
    "portable_rule",
    "unreal",
    "context_compactor",
    "cline"
  ],
  "safety": {
    "defaultReadOnly": true,
    "agentModeRequires": ["--enable-agent-mode", "--accept-agent-risk"],
    "interactiveAgentModeSelector": true,
    "indexTierIsIndependent": true,
    "contextCompactorRequiredWithLmStudio": true
  },
  "portablePackage": {
    "launchers": ["INSTALL.bat", "install.sh"],
    "indexIncludedByDefault": false,
    "supportedHosts": ["windows", "ubuntu-linux", "macos-apple-silicon"],
    "hostNotes": {
      "macos-apple-silicon": "Installer available; LM Studio live certification and notarization pending",
      "macos-intel": "LM Studio configuration unsupported; custom Codex/portable_rule/Cline-only allowed"
    },
    "runtimeArchiveIntegrity": "pinned-sha256",
    "safeExtraction": true,
    "releaseReady": false
  }
}
