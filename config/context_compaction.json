{
  "schemaVersion": 1,
  "description": "Shared context compaction policy. Control-plane state is never represented only by a natural-language summary.",
  "enabled": true,
  "observeOnly": false,
  "strictToolControlPlane": false,
  "bufferUntilPredictionComplete": true,
  "rejectTruncatedPredictions": true,
  "requireCheckpointPersistence": true,
  "softRemainingTokens": 14000,
  "hardRemainingTokens": 8000,
  "maxOutputReserve": 4096,
  "architectureMaxOutputReserve": 6144,
  "architectureEvidenceReadThreshold": 4,
  "architectureEvidenceHardLimit": 8,
  "architectureReplanEvidenceReadBudget": 4,
  "safetyMarginTokens": 1024,
  "temperature": 0.1,
  "normalToolResultReserve": 3000,
  "buildToolResultReserve": 8000,
  "recentCompleteTurns": 4,
  "minimumTurnsBetweenCompactions": 0,
  "targetRemainingTokensAfterCompaction": 24000,
  "maxCheckpointFacts": 32
}
