    {
      "id": "ue.uobject.lifecycle",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "lifecycle",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "UObject"
        ]
      },
      "statement": "PostInitProperties, PostLoad and BeginDestroy are UObject virtuals, so they are valid overrides on every UObject-derived type, including actors, components and subsystems. BeginDestroy runs as part of garbage-collection teardown; it is not a gameplay end-of-play hook.",
      "preconditions": [
        "The type derives from UObject."
      ],
      "exceptions": [
        "A valid BeginDestroy override is not a recommendation to put gameplay cleanup there; use EndPlay or Deinitialize for that."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/CoreUObject/Public/UObject/Object.h",
          "symbol": "UObject::PostInitProperties",
          "line": 226
        },
        {
          "path": "Engine/Source/Runtime/CoreUObject/Public/UObject/Object.h",
          "symbol": "UObject::PostLoad",
          "line": 346
        },
        {
          "path": "Engine/Source/Runtime/CoreUObject/Public/UObject/Object.h",
          "symbol": "UObject::BeginDestroy",
          "line": 361
        }
      ],
      "guidanceRefs": [
        "unreal.md#lifetime"
      ]
    },
    {
      "id": "ue.actor.lifecycle",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "lifecycle",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "AActor"
        ]
      },
      "statement": "AActor gameplay lifetime runs PostInitializeComponents, then BeginPlay, and ends with EndPlay. AActor::Destroyed calls RouteEndPlay(EEndPlayReason::Destroyed) first, so cleanup that must run on every end of play belongs in EndPlay.",
      "preconditions": [
        "The type derives from AActor."
      ],
      "exceptions": [
        "Level unload, PIE end and world teardown also call EndPlay with a different reason; Destroyed is not called for those."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/Engine/Classes/GameFramework/Actor.h",
          "symbol": "AActor::BeginPlay",
          "line": 2125
        },
        {
