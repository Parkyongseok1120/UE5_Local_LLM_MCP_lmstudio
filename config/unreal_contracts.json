    {
      "id": "ue.subsystem.lifecycle",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "subsystem",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "USubsystem",
          "UWorldSubsystem",
          "UGameInstanceSubsystem",
          "UEngineSubsystem",
          "ULocalPlayerSubsystem"
        ]
      },
      "statement": "A subsystem lives as long as its outer: Engine, GameInstance, World or LocalPlayer. ShouldCreateSubsystem gates creation, Initialize(FSubsystemCollectionBase&) and Deinitialize bracket its life. World subsystems also receive PostInitialize, OnWorldBeginPlay, OnWorldEndPlay and PreDeinitialize, and DoesSupportWorldType filters world types.",
      "preconditions": [
        "The type derives from USubsystem."
      ],
      "exceptions": [
        "A world subsystem is created per world, including editor and PIE worlds unless DoesSupportWorldType filters them."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/Engine/Public/Subsystems/Subsystem.h",
