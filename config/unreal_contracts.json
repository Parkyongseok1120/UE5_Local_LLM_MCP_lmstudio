    {
      "id": "policy.claims.engine-default-vs-project",
      "revision": 2,
      "kind": "project_policy",
      "topic": "verification",
      "applicability": {
        "engineVersions": [
          "*"
        ]
      },
      "statement": "Separate what the engine already does from what the project adds. Before saying a capability is missing, check the engine base class with unreal_symbol_lookup(sourceMode=engine_local); before saying a setting is unreadable, read the file (Config/*.ini files are text). Before stating what an engine function returns or does, read its implementation: sourceMode=engine_local lists .cpp definition candidates, and read_file_range reads engine://Engine/Source/... with line numbers.",
      "preconditions": [
        "A finding says an engine capability is absent or a configuration cannot be checked."
      ],
      "exceptions": [],
      "evidenceRefs": [],
      "guidanceRefs": [
        "unreal.md#verification"
      ]
    },
