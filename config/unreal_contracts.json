    {
      "id": "ue.subsystem.initialize-dependency",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "subsystem",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "USubsystem"
        ]
      },
      "statement": "FSubsystemCollectionBase::InitializeDependency forces another subsystem of the same collection to initialize first. It only orders subsystems within one collection.",
      "preconditions": [
        "Initialize uses another subsystem of the same collection (for example two world subsystems of one world)."
      ],
      "exceptions": [
        "A subsystem of a different collection (a world subsystem using a game-instance subsystem) is outside InitializeDependency.",
        "Storing a reference for later use does not depend on initialization order."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/Engine/Public/Subsystems/SubsystemCollection.h",
          "symbol": "FSubsystemCollectionBase::InitializeDependency",
          "line": 35
        }
      ],
      "guidanceRefs": [
        "unreal.md#subsystems"
      ]
    },
    {
      "id": "ue.timer.game-thread",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "threading",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "FTimerManager"
        ]
      },
      "statement": "FTimerManager setting and lookup check IsInGameThread; timers must be set and cleared on the game thread, and a timer bound to an object must be cleared when that object ends play.",
      "preconditions": [
        "Code calls SetTimer, ClearTimer or timer queries."
      ],
      "exceptions": [
        "A timer callback hopping back to the game thread before touching timers is valid."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/Engine/Private/TimerManager.cpp",
          "symbol": "FTimerManager::FindTimer check(IsInGameThread())",
          "line": 596
        },
        {
          "path": "Engine/Source/Runtime/Engine/Private/TimerManager.cpp",
          "symbol": "FTimerManager::InternalSetTimer check(IsInGameThread())",
          "line": 660
        }
      ],
      "guidanceRefs": [
        "unreal.md#lifetime"
      ]
    },
    {
      "id": "ue.thread.uobject-game-thread",
      "revision": 1,
      "kind": "project_policy",
      "topic": "threading",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "contexts": [
          "AsyncTask",
          "ParallelFor",
          "Async",
          "FRunnable",
          "UE::Tasks::Launch"
        ]
      },
      "statement": "Create, destroy, spawn and mutate UObjects, actors, components, worlds and timers on the game thread. Work on another thread uses copied plain data, and returns results with AsyncTask(ENamedThreads::GameThread, ...) after checking a TWeakObjectPtr is still valid.",
      "preconditions": [
        "A lambda or task runs on a worker thread."
      ],
      "exceptions": [
        "A nested AsyncTask(ENamedThreads::GameThread, ...) body runs on the game thread.",
        "Thread-safe engine APIs documented as such."
      ],
      "evidenceRefs": [
        {
          "path": "Engine/Source/Runtime/Engine/Private/TimerManager.cpp",
          "symbol": "FTimerManager::InternalSetTimer check(IsInGameThread())",
          "line": 660
        }
      ],
      "guidanceRefs": [
        "unreal.md#threads",
        "34_Threading_And_Async_Contract.md"
      ]
    },
    {
      "id": "policy.render.game-objects",
      "revision": 1,
      "kind": "project_policy",
      "topic": "threading",
      "applicability": {
        "engineVersions": [
          "*"
        ],
        "contexts": [
          "ENQUEUE_RENDER_COMMAND"
        ]
      },
      "statement": "A render command runs later on the rendering thread. Pass copied values or a render proxy into it; do not capture this or other gameplay UObjects and read or mutate them there.",
      "preconditions": [
        "Code enqueues a render command from gameplay code."
      ],
      "exceptions": [
        "Scene proxies and render-thread resources owned by the render thread.",
        "Values copied into the lambda capture before enqueueing."
      ],
      "evidenceRefs": [],
      "guidanceRefs": [
        "unreal.md#threads",
        "34_Threading_And_Async_Contract.md"
      ]
    },
    {
      "id": "ue.net.cmc-prediction",
      "revision": 1,
      "kind": "engine_fact",
      "topic": "networking",
      "applicability": {
        "engineVersions": [
          "5.8"
        ],
        "types": [
          "UCharacterMovementComponent",
          "ACharacter"
        ]
      },
      "statement": "UCharacterMovementComponent already performs owning-client movement prediction: the client moves locally and sends moves with ReplicateMoveToServer, and the server corrects significant errors with ClientAdjustPosition. A project without its own prediction layer still has engine movement prediction.",
      "preconditions": [
        "The pawn uses UCharacterMovementComponent."
      ],
      "exceptions": [
        "Custom movement state outside the saved-move system is not predicted unless the project extends FSavedMove."
      ],
      "evidenceRefs": [
