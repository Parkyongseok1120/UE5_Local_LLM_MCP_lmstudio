      "id": "cmc_prediction_is_engine_default",
      "origin": "Latency_MultiCombat review: claimed the default CharacterMovementComponent has no movement prediction",
      "contractIds": [
        "ue.net.cmc-prediction",
        "policy.claims.engine-default-vs-project"
      ],
      "category": [
        "networking",
        "engine_default"
      ],
      "prompt": "이 캐릭터의 네트워크 이동 구조를 검토해라. 엔진 기본 동작과 프로젝트가 추가한 구현을 구분해서 설명하라.",
      "files": [
        {
          "path": "Source/Combat/Public/CombatCharacter.h",
          "content": "#pragma once\n\n#include \"CoreMinimal.h\"\n#include \"GameFramework/Character.h\"\n#include \"CombatCharacter.generated.h\"\n\nUCLASS()\nclass COMBAT_API ACombatCharacter : public ACharacter\n{\n    GENERATED_BODY()\n\npublic:\n    ACombatCharacter();\n\nprotected:\n    void Move(const FVector2D& Axis);\n};\n"
        },
        {
          "path": "Source/Combat/Private/CombatCharacter.cpp",
          "content": "#include \"CombatCharacter.h\"\n\nACombatCharacter::ACombatCharacter()\n{\n    bReplicates = true;\n}\n\nvoid ACombatCharacter::Move(const FVector2D& Axis)\n{\n    AddMovementInput(GetActorForwardVector(), Axis.Y);\n    AddMovementInput(GetActorRightVector(), Axis.X);\n}\n"
        }
      ],
      "expected_findings": [
        {
          "id": "engine_cmc_prediction",
          "points": 2.0,
          "diagnosis": [
            "(CharacterMovement|CMC)",
            "(예측|predict)",
            "(보정|correct|ClientAdjustPosition|서버\\s*검증|reconcil)"
          ]
        }
      ],
      "forbidden_patterns": [
        {
          "id": "claims_no_engine_prediction",
          "penalty": 2.0,
          "patterns": [
            "(CMC|CharacterMovement\\w*)[^.\\n]{0,30}(예측(이|은|기능)?\\s*(이\\s*)?없(다|음|습니다)|예측을\\s*(하지\\s*않|지원하지\\s*않))",
            "(has|have|with)\\s+no\\s+(client[- ]side\\s+)?(movement\\s+)?prediction"
          ]
        }
      ]
    },
