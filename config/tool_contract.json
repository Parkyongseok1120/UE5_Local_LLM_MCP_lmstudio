{
  "version": 2,
  "description": "Direct Model Mode capability classification. This registry describes effects and timeouts only; it does not authorize, order, route, or require tool calls.",
  "sourceManifest": "config/stable_tool_manifest.json",
  "timeoutClasses": {
    "fast": 15000,
    "read": 60000,
    "validate": 120000,
    "build": 900000,
    "background": 3600000
  },
  "sideEffectClasses": {
    "read_only": [
      "unreal_get_active_project",
      "unreal_rag_search",
      "unreal_symbol_lookup",
      "unreal_rag_health",
      "unreal_rag_rebuild_status",
      "unreal_rag_capabilities",
      "get_workspace_info",
      "list_unreal_projects",
      "get_active_project",
      "detect_unreal_project",
      "list_directory",
      "search_files",
      "read_file",
      "read_file_range",
      "read_symbol",
      "read_unreal_logs",
      "propose_file_deletions",
      "static_validate_project"
    ],
    "configuration": ["unreal_set_active_project", "set_active_project"],
    "write": ["write_file", "replace_in_file", "apply_edit_bundle", "delete_file"],
    "index_maintenance": ["unreal_rag_refresh"],
    "diagnostic_process": ["build_unreal_project", "run_unreal_automation_tests", "run_command"]
  },
  "servers": {
    "rag": {
      "essential": "ragEssential",
      "visible": "ragEssential"
    },
    "agent": {
      "essential": "agentEssential",
      "visible": "agentEssential"
    }
  },
  "malformedArgsPolicy": {
    "ragErrorCode": "INVALID_TOOL_ARGUMENTS",
    "agentErrorCode": "INVALID_ARGUMENTS",
    "retryableWithCorrectedArguments": true
  },
  "conditionalExternalProcesses": {
    "unreal_rag_refresh": {
      "argument": "allowEditorLaunch",
      "requiredValue": true,
      "scopes": ["editor_metadata", "all"],
      "defaultScope": "project_source",
      "effect": "May start an Unreal Editor subprocess to create fresh metadata exports. Without explicit true, only existing exports may be ingested."
    }
  }
}
