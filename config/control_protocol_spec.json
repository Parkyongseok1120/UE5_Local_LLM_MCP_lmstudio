{
  "schemaVersion": 1,
  "protocolVersion": 2,
  "transitionPolicy": {
    "dispositions": [
      "continue",
      "require_tool",
      "rediscover",
      "checkpoint",
      "await_user",
      "workflow_stop",
      "complete"
    ],
    "retryPolicies": [
      "allowed",
      "once",
      "forbidden"
    ],
    "taskStatuses": {
      "completed": "complete",
      "cancelled": "workflow_stop",
      "failed": "workflow_stop",
      "cancellation_uncertain": "workflow_stop",
      "pending_approval": "await_user",
      "awaiting_approval": "await_user",
      "running": "derive"
    },
    "recoveryStatuses": {
      "external_blocker": {
        "disposition": "await_user",
        "retry": "forbidden"
      },
      "await_user": {
        "disposition": "await_user",
        "retry": "forbidden"
      },
      "evidence_complete": {
        "disposition": "continue",
        "retry": "forbidden",
        "toolFreeSynthesis": true
      },
      "environment_recovery": {
        "disposition": "require_tool",
        "retry": "once",
        "maxCommittedFailures": 2,
        "onExhausted": "await_user",
        "requiredUserInputKind": "provide_path"
      },
      "evidence_required": {
        "disposition": "require_tool",
        "retry": "once"
      },
      "repair_planning_required": {
        "disposition": "require_tool",
        "retry": "once"
      },
      "revalidate_required": {
        "disposition": "require_tool",
        "retry": "once"
      },
      "checkpoint_rebase_required": {
        "disposition": "checkpoint",
        "retry": "once"
      },
      "phase_budget_checkpoint_required": {
        "disposition": "checkpoint",
        "retry": "once"
      },
      "repair_required": {
        "disposition": "require_tool",
        "retry": "once"
      }
    },
    "runningStateInvariant": {
      "requiredToolMustBeAllowed": true,
      "requiredToolMustNotBeForbidden": true,
      "terminalDispositionsHaveNoAllowedTools": true,
      "toolFreeSynthesisHasNoAllowedTools": true,
      "toolRoutePhaseEqualsControlPhase": true,
      "toolRouteActiveToolsEqualControlAllowedTools": true,
      "awaitUserRequiresStructuredInput": true,
      "missingInternalRecoveryToolStopsWorkflow": true
    },
    "sourceEvidenceDiscovery": {
      "freshTaskRequiresPersistedInitialAction": true,
      "freshTaskMayNotReportFrontierLost": true,
      "frontierLostRequiresDiscoveryStarted": true,
      "frontierLostRequiresPriorNonemptyFrontier": true,
      "discoveryExhaustionDisposition": "workflow_stop"
    },
    "synthesisNack": {
      "continueRecoveryInSameGenerateInvocation": true,
      "retainPreparedBytes": true,
      "preparedProvenanceUsesRejectedTransactionControl": true
    }
  },
  "authorizationSchema": {
    "version": 1,
    "requiredFields": [
      "taskSessionId",
      "authToken",
      "ownerCapability",
      "conversationId",
