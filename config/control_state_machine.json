{
  "version": 1,
  "semanticOwner": {
    "id": "python_task_server",
    "module": "scripts/phase_tool_router.py",
    "reducer": "commit_control_transition",
    "durableState": "task state.json"
  },
  "adapters": {
    "nodeAgentMcp": {
      "role": "execute_and_record_committed_events",
      "mayChooseSemanticControl": false
    },
    "lmStudioCompactor": {
      "role": "preserve_control_execute_exact_commands_and_deliver",
      "mayChooseSemanticControl": false,
      "localRecoveryNamespace": "proxyRecovery"
    }
  },
  "lifecycleStates": [
    "BOOTSTRAP",
    "INITIAL_DISCOVERY_REQUIRED",
    "DISCOVERY_IN_PROGRESS",
    "EVIDENCE_REQUIRED",
    "EVIDENCE_COLLECTING",
    "EVIDENCE_READY",
    "MUTATION_REQUIRED",
    "STATIC_VALIDATION_REQUIRED",
    "BUILD_REQUIRED",
    "AUTOMATION_REQUIRED",
    "SYNTHESIS_REQUIRED",
    "SYNTHESIS_PREPARED",
    "SYNTHESIS_COMMIT_REQUIRED",
    "DELIVERY_REQUIRED",
    "AWAITING_USER_INPUT",
    "DELIVERY_RECOVERY_AWAITING_USER",
    "COMPLETE",
    "TERMINAL_BLOCKED",
    "CANCELLED"
  ],
  "terminalLifecycleStates": [
    "COMPLETE",
    "TERMINAL_BLOCKED",
    "CANCELLED"
  ],
  "lifecycleEvents": [
    "TASK_STARTED",
    "INITIAL_DISCOVERY_REQUESTED",
    "DISCOVERY_RESULT_COMMITTED",
    "EVIDENCE_READ_COMMITTED",
    "EVIDENCE_BUDGET_EXHAUSTED",
    "EVIDENCE_READY_COMMITTED",
    "SCOPE_APPROVAL_REQUESTED",
    "USER_INPUT_COMMITTED",
    "MUTATION_COMMITTED",
    "STATIC_VALIDATION_PASSED",
    "STATIC_VALIDATION_FAILED",
    "BUILD_PASSED",
    "BUILD_FAILED",
    "AUTOMATION_PASSED",
    "AUTOMATION_FAILED",
    "SYNTHESIS_PREPARED",
    "SYNTHESIS_COMMIT_ACKED",
    "SYNTHESIS_COMMIT_REJECTED",
    "DELIVERY_ACKED",
    "DELIVERY_UNCERTAIN",
    "OPERATOR_CONFIRMED_VISIBLE",
    "OPERATOR_AUTHORIZED_REEMIT",
    "TASK_CANCELLED",
    "TERMINAL_BLOCKER_COMMITTED"
  ],
  "lifecycleTransitions": {
    "BOOTSTRAP": [
      {"event": "TASK_STARTED", "next": "INITIAL_DISCOVERY_REQUIRED"},
      {"event": "TASK_STARTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "SCOPE_APPROVAL_REQUESTED", "next": "AWAITING_USER_INPUT"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "INITIAL_DISCOVERY_REQUIRED": [
      {"event": "INITIAL_DISCOVERY_REQUESTED", "next": "DISCOVERY_IN_PROGRESS"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"}
    ],
    "DISCOVERY_IN_PROGRESS": [
      {"event": "DISCOVERY_RESULT_COMMITTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "DISCOVERY_RESULT_COMMITTED", "next": "EVIDENCE_COLLECTING"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "EVIDENCE_REQUIRED": [
      {"event": "EVIDENCE_READ_COMMITTED", "next": "EVIDENCE_COLLECTING"},
      {"event": "SCOPE_APPROVAL_REQUESTED", "next": "AWAITING_USER_INPUT"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "EVIDENCE_COLLECTING": [
      {"event": "EVIDENCE_READY_COMMITTED", "next": "EVIDENCE_READY"},
      {"event": "EVIDENCE_BUDGET_EXHAUSTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "EVIDENCE_READY": [
      {"event": "SYNTHESIS_PREPARED", "next": "SYNTHESIS_REQUIRED"},
      {"event": "USER_INPUT_COMMITTED", "next": "MUTATION_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "MUTATION_REQUIRED": [
      {"event": "MUTATION_COMMITTED", "next": "STATIC_VALIDATION_REQUIRED"},
      {"event": "SCOPE_APPROVAL_REQUESTED", "next": "AWAITING_USER_INPUT"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "STATIC_VALIDATION_REQUIRED": [
      {"event": "STATIC_VALIDATION_PASSED", "next": "BUILD_REQUIRED"},
      {"event": "STATIC_VALIDATION_FAILED", "next": "MUTATION_REQUIRED"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "BUILD_REQUIRED": [
      {"event": "BUILD_PASSED", "next": "AUTOMATION_REQUIRED"},
      {"event": "BUILD_PASSED", "next": "COMPLETE"},
      {"event": "BUILD_FAILED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "AUTOMATION_REQUIRED": [
      {"event": "AUTOMATION_PASSED", "next": "COMPLETE"},
      {"event": "AUTOMATION_FAILED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "SYNTHESIS_REQUIRED": [
      {"event": "SYNTHESIS_PREPARED", "next": "SYNTHESIS_PREPARED"},
      {"event": "EVIDENCE_BUDGET_EXHAUSTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TERMINAL_BLOCKER_COMMITTED", "next": "TERMINAL_BLOCKED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "SYNTHESIS_PREPARED": [
      {"event": "SYNTHESIS_PREPARED", "next": "SYNTHESIS_COMMIT_REQUIRED"},
      {"event": "SYNTHESIS_COMMIT_REJECTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "SYNTHESIS_COMMIT_REQUIRED": [
      {"event": "SYNTHESIS_COMMIT_ACKED", "next": "DELIVERY_REQUIRED"},
      {"event": "SYNTHESIS_COMMIT_REJECTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "DELIVERY_REQUIRED": [
      {"event": "DELIVERY_ACKED", "next": "COMPLETE"},
      {"event": "DELIVERY_UNCERTAIN", "next": "DELIVERY_RECOVERY_AWAITING_USER"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "AWAITING_USER_INPUT": [
      {"event": "USER_INPUT_COMMITTED", "next": "EVIDENCE_REQUIRED"},
      {"event": "USER_INPUT_COMMITTED", "next": "MUTATION_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "DELIVERY_RECOVERY_AWAITING_USER": [
      {"event": "OPERATOR_CONFIRMED_VISIBLE", "next": "COMPLETE"},
      {"event": "OPERATOR_AUTHORIZED_REEMIT", "next": "DELIVERY_REQUIRED"},
      {"event": "TASK_CANCELLED", "next": "CANCELLED"}
    ],
    "COMPLETE": [],
    "TERMINAL_BLOCKED": [],
    "CANCELLED": []
  },
  "events": [
    "PHASE_BUDGET_EXHAUSTED",
    "EVIDENCE_STAGNATION",
    "GATE_VALIDATION_FAILED",
    "HANDLER_RECOVERY_FACT",
    "TOOL_RESULT_COMMITTED"
  ],
  "eventHandlers": {
    "PHASE_BUDGET_EXHAUSTED": "phase_budget_exhausted",
    "EVIDENCE_STAGNATION": "evidence_stagnation",
    "GATE_VALIDATION_FAILED": "gate_validation_failed",
    "HANDLER_RECOVERY_FACT": "handler_recovery_fact",
    "TOOL_RESULT_COMMITTED": "tool_result_committed"
  },
  "runningLivenessAlternatives": [
    "exact_required_tool",
    "deterministic_internal_command",
    "bounded_exploratory_route",
    "typed_resumable_user_input",
    "truthful_terminal_control"
  ],
  "discoveryLifecycle": {
    "emptyInitialFrontier": "INITIAL_DISCOVERY_REQUIRED",
    "frontierLostRequires": [
      "discoveryStarted",
      "everHadFrontier",
      "failedReconstruction",
      "noDeterministicPairRecovery",
      "noBoundedSearchRecovery",
      "boundedReplanApplied"
    ]
  },
  "evidenceLevels": [
    "DISCOVERED",
    "RANGE_PARTIAL",
    "SYMBOL_COMPLETE",
    "FILE_COMPLETE",
    "CLAIM_VALIDATED"
  ],
  "evidenceIdentityFields": [
    "canonicalPath",
    "contentHash",
    "applicableGeneration",
    "coveredRanges",
    "wholeFileComplete",
    "truncated",
    "lineCount",
    "sourceKind",
    "semanticAnchorDigest"
  ],
  "compatibleReplanRequires": [
    "sameTaskSession",
    "sameObjectiveHash",
    "sameCanonicalProject",
    "sameCanonicalPath",
    "sameContentHash",
    "sameApplicableMutationGeneration",
    "sameEvidenceSemantics"
  ],
  "budgetPolicies": {
    "global_abuse_guard": {
      "owner": "agent_process",
      "persistence": "process_local",
      "limit": "24 calls per 5 minute sliding window and 2 calls per scoped path",
      "scope": "task session when available, otherwise conversation plus project",
      "resetRule": "sliding_window_or_process_restart",
      "resumeAction": "search_files_or_known_file_read"
    },
    "durable_workflow_budget": {
      "owner": "python_task_state",
      "persistence": "task_state",
      "limit": "inspectionContract.evidenceBudget.maxDirectoryLists per phase",
      "scope": "taskSessionId plus plan revision and phase",
      "resetRule": "checkpoint_then_compatible_replan",
      "resumeAction": "unreal_task_checkpoint"
    }
  },
  "capacityPolicies": {
    "inspectionFrontier": {
      "producerMaximumPerResult": 1000,
      "durableMaximum": 4096,
      "overflowDisposition": "workflow_stop",
      "overflowCode": "EVIDENCE_FRONTIER_CAPACITY_EXCEEDED",
      "requiredProofFields": [
        "remainingFrontierTotalCount",
        "remainingFrontierHash",
        "frontierOverflow"
      ]
    },
    "repositoryAuditPage": {
      "pageSize": 128,
      "sourceEvidenceRetention": 4096,
      "maximumInventoryFiles": 4096,
      "retentionRule": "all bounded inventory files remain citation-eligible until terminal synthesis",
      "overflowDisposition": "workflow_stop",
      "overflowCode": "REPO_AUDIT_INVENTORY_OVERFLOW"
    },
    "slicePlan": {
      "maximumSlices": 1024,
      "checkpointCompletedSliceCapacity": 1024
    },
    "controlProjection": {
      "maximumModelVisibleCharacters": 32000,
      "requiredHeaderFields": [
        "version",
        "authoritative",
        "epoch",
        "taskSessionId",
        "planRevision",
        "mutationGeneration",
        "fingerprint",
        "routeHash",
        "phase",
        "disposition",
        "requiredTool",
        "allowedTools",
        "retryPolicy"
      ]
    }
  },
  "recoveryTransitions": {
    "evidence_required": {
      "satisfactionEvent": "RECOVERY_EVIDENCE_ACCEPTED",
      "nextStatus": "repair_planning_required",
      "nextLifecycle": "EVIDENCE_READY"
    },
    "repair_planning_required": {
      "satisfactionEvent": "GATE_SUCCEEDED",
      "nextStatus": "repair_required",
      "nextLifecycle": "MUTATION_REQUIRED"
    },
    "repair_required": {
      "satisfactionEvent": "MUTATION_COMMITTED",
      "nextStatus": "revalidate_required",
      "nextLifecycle": "STATIC_VALIDATION_REQUIRED"
    },
    "revalidate_required": {
      "satisfactionEvent": "STATIC_VALIDATION_PASSED",
      "nextStatus": "build_required",
      "nextLifecycle": "BUILD_REQUIRED"
    },
    "checkpoint_rebase_required": {
      "satisfactionEvent": "CHECKPOINT_RECORDED",
      "nextStatus": "prior_active_status",
      "nextLifecycle": "prior_active_lifecycle"
    },
    "phase_budget_checkpoint_required": {
      "satisfactionEvent": "CHECKPOINT_RECORDED",
      "nextStatus": "phase_budget_replan_required",
      "nextLifecycle": "EVIDENCE_REQUIRED"
    },
    "phase_budget_replan_required": {
      "satisfactionEvent": "PLAN_REVISED",
      "nextStatus": "evidence_required",
      "nextLifecycle": "EVIDENCE_REQUIRED"
    },
    "environment_recovery": {
      "satisfactionEvent": "DISCOVERY_SUCCEEDED",
      "nextStatus": "prior_active_status",
      "nextLifecycle": "prior_active_lifecycle"
    },
    "evidence_complete": {
      "satisfactionEvent": "SYNTHESIS_PREPARED",
      "nextStatus": "synthesis_prepared",
      "nextLifecycle": "SYNTHESIS_PREPARED"
    }
  },
  "synthesisLifecycle": [
    "pending",
    "prepared",
    "commit_sent",
    "commit_acked",
    "delivery_pending",
    "delivery_uncertain",
    "delivery_reemit_authorized",
    "delivered",
    "rejected_stale",
    "evidence_recovery"
  ],
  "proxyLifecycleStates": [
    "pending",
    "prepared",
    "completed",
    "commit_sent",
    "commit_acked",
    "delivery_pending",
    "delivery_uncertain",
    "delivery_reemit_authorized",
    "committed",
    "delivered",
    "rejected_stale",
    "evidence_recovery"
  ],
  "synthesisBindingFields": [
    "taskSessionId",
    "objectiveHash",
    "evidenceStateHash",
    "remainingFrontierHash",
    "planRevision",
    "controlEpoch",
    "mutationGeneration",
    "synthesisEvidenceBundleHash",
    "outputDigest"
  ],
  "completionRule": "task completion requires synthesis commit acknowledgement and delivery acknowledgement"
}
