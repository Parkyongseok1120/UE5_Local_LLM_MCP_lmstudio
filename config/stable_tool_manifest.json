    "minimum": {
      "field": "maxChars|byteBudget|maxBytes",
      "value": "positive integer in the named field unit"
    },
    "description": "Failed results retain errorCode and retry. A retry minimum is scoped to the returned tool/request, and must survive wire normalization. SDK bare errors require guard evidence before counting as budget denial."
