{
  "name": "unreal-context-compactor",
  "version": "0.4.77",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "patch:sdk": "node scripts/patch-lmstudio-sdk.cjs",
    "postinstall": "node scripts/patch-lmstudio-sdk.cjs",
    "guidance:build": "node scripts/build-design-guidance.cjs",
    "guidance:check": "node scripts/build-design-guidance.cjs --check",
    "toolcontract:build": "node scripts/build-tool-contract.cjs",
    "toolcontract:check": "node scripts/build-tool-contract.cjs --check",
    "identity:build": "node scripts/build-runtime-identity.cjs",
    "identity:check": "node scripts/build-runtime-identity.cjs --check",
    "prebuild": "node scripts/patch-lmstudio-sdk.cjs && npm run guidance:build && npm run toolcontract:build && npm run identity:build",
    "predev": "npm run prebuild",
    "dev": "lms dev",
    "clean": "node scripts/clean-dist.cjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "verify:install": "npm run build && npm run identity:check && node scripts/status.cjs",
    "eval:availability-ab": "npm run build && node scripts/eval-input-availability-ab.cjs",
    "eval:audit-pressure": "npm run build && node scripts/eval-audit-pressure.cjs",
    "eval:hybrid-context": "npm run build && node scripts/eval-hybrid-context.cjs",
    "test": "npm run build && node scripts/run-tests.cjs",
    "test:active": "npm run build && node scripts/status.cjs --require-runtime",
    "status": "node scripts/status.cjs"
  },
  "dependencies": {
    "@lmstudio/sdk": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "typescript": "^5.9.3"
  }
}
